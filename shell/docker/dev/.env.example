# Host ports
HEADSCALE_HTTP_PORT=5080
PANEL_HTTP_PORT=8090
INFLUXDB_HOST_PORT=8086

# Images
# Default dev mode runs a released Headscale container image directly.
# When targeting an unreleased commit (e.g. 0.30.0-dev), use `mise run dev:up:source`
# (which sets HS_BUILD_FROM_SOURCE=1 and builds from AdaptedHeadscaleCommit).
HEADSCALE_IMAGE_RELEASE=ghcr.io/juanfont/headscale:0.30.0
HEADSCALE_IMAGE_SOURCE=
TAILSCALE_IMAGE=tailscale/tailscale:stable
PANEL_IMAGE=headscale-panel:dev

# Panel
PANEL_BASE_URL=http://localhost:8090/panel
SETUP_BOOTSTRAP_TOKEN=dev-bootstrap-token-change-me-0123456789
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_EMAIL=admin@example.com
PANEL_ADMIN_PASSWORD=dev-admin-password-1234

# InfluxDB
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=adminpassword
INFLUXDB_TOKEN=dev-influxdb-token
INFLUXDB_ORG=headscale-panel
INFLUXDB_BUCKET=metrics
